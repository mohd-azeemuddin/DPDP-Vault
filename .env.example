# GEMINI_API_KEY: Required for Gemini AI API calls (Hinglish contextual disambiguation, multimodal screenshot redaction, embeddings, and grounded RAG).
# Configure via Settings > Secrets in AI Studio or Render/hosting env vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VAULT_MASTER_KEY: Optional 64-char hex key (32 bytes) for wrapping per-principal DEKs.
# If omitted, a local development key is generated in ./data/.master.key.
VAULT_MASTER_KEY=""

# DPDP_API_TOKEN: Optional bearer token to protect mutating and MCP endpoints in production.
# Leave empty for open public demo mode (rate-limited).
DPDP_API_TOKEN=""
